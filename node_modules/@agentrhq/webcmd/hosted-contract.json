          "positional": false,
          "required": false,
          "variadic": false,
          "default": 30
        },
        {
          "name": "max-chars",
          "type": "int",
          "description": "Maximum extracted characters; 0 disables truncation",
          "positional": false,
          "required": false,
          "variadic": false,
          "default": 50000
